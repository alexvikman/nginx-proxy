{{- /* Generated nginx http{} configuration. Rendered by internal/proxy/render.go. */ -}}
# Generated by nginx-proxy {{ .Version }}. Do not edit: this file is rewritten on every change.

{{- if .TrustedProxies }}
# TRUSTED_PROXIES: the client address is taken from {{ .RealIPHeader }}, and the
# X-Forwarded-* headers are believed, only for requests from these ranges.
# Anyone else gets their own address and this server's scheme, host and port.
{{- range .TrustedProxies }}
set_real_ip_from {{ . }};
{{- end }}
real_ip_header {{ .RealIPHeader }};
real_ip_recursive on;

geo $realip_remote_addr $proxy_from_trusted {
    default 0;
{{- range .TrustedProxies }}
    {{ . }} 1;
{{- end }}
}

map "$proxy_from_trusted:$http_x_forwarded_proto" $proxy_x_forwarded_proto {
    default         $scheme;
    "~^1:(https?)$" $1;
}

map "$proxy_from_trusted:$http_x_forwarded_host" $proxy_x_forwarded_host {
    default      $host;
    "~^1:(.+)$"  $1;
}

map "$proxy_from_trusted:$http_x_forwarded_port" $proxy_x_forwarded_port {
    default             $server_port;
    "~^1:([0-9]{1,5})$" $1;
}
{{- else }}
# If we receive X-Forwarded-Proto, pass it through; otherwise, pass along the
# scheme used to connect to this server.
map $http_x_forwarded_proto $proxy_x_forwarded_proto {
{{- if .TrustDownstreamProxy }}
    default $http_x_forwarded_proto;
    ''      $scheme;
{{- else }}
    default $scheme;
{{- end }}
}

map $http_x_forwarded_host $proxy_x_forwarded_host {
{{- if .TrustDownstreamProxy }}
    default $http_x_forwarded_host;
    ''      $host;
{{- else }}
    default $host;
{{- end }}
}

map $http_x_forwarded_port $proxy_x_forwarded_port {
{{- if .TrustDownstreamProxy }}
    default $http_x_forwarded_port;
    ''      $server_port;
{{- else }}
    default $server_port;
{{- end }}
}
{{- end }}

# Pass "Connection: upgrade" when the client asks for a protocol upgrade.
# Otherwise keep the upstream connection open when keepalive is enabled.
map $http_upgrade $proxy_connection {
    default upgrade;
    ''      $proxy_connection_noupgrade;
}
map $upstream_keepalive $proxy_connection_noupgrade {
    default close;
    true    '';
}
# Make sure $upstream_keepalive is always defined; locations override it.
map "" $upstream_keepalive {
    default false;
}

map $proxy_x_forwarded_proto $proxy_x_forwarded_ssl {
    default off;
    https   on;
}

server_names_hash_bucket_size 128;
server_tokens off;

ssl_session_cache shared:SSL:50m;
ssl_session_timeout 5m;
ssl_session_tickets off;
{{- if .DHParam }}
ssl_dhparam {{ .DHParam }};
{{- end }}
{{- if .Resolvers }}
resolver {{ .Resolvers }};
{{- end }}

{{- if .LogFormat }}
log_format vhost escape={{ .LogFormatEscape }} '{{ .LogFormat }}';
{{- else if .LogJSON }}
log_format vhost escape=json '{"time_local":"$time_iso8601","client_ip":"$remote_addr","remote_user":"$remote_user","request":"$request","status":"$status","body_bytes_sent":"$body_bytes_sent","request_time":"$request_time","upstream_response_time":"$upstream_response_time","upstream_addr":"$upstream_addr","http_referrer":"$http_referer","http_user_agent":"$http_user_agent","request_id":"$request_id","vhost":"$host"}';
{{- else }}
log_format vhost escape={{ .LogFormatEscape }} '$host $remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent "$http_referer" "$http_user_agent" "$upstream_addr"';
{{- end }}
access_log off;

{{- if .ProxyConf }}
include /etc/nginx/proxy.conf;
{{- else }}

proxy_http_version 1.1;
proxy_set_header Host $http_host;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $proxy_connection;
proxy_set_header X-Real-IP $remote_addr;
{{- if .TrustedProxies }}
# The client address the trusted proxies vouch for, without the addresses a
# client may have put in front of it.
proxy_set_header X-Forwarded-For $remote_addr;
{{- else if .TrustDownstreamProxy }}
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
{{- else }}
# No trusted proxy in front: a client-supplied X-Forwarded-For is replaced, not extended.
proxy_set_header X-Forwarded-For $remote_addr;
{{- end }}
proxy_set_header X-Forwarded-Host $proxy_x_forwarded_host;
proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
proxy_set_header X-Forwarded-Ssl $proxy_x_forwarded_ssl;
proxy_set_header X-Forwarded-Port $proxy_x_forwarded_port;
proxy_set_header X-Original-URI $request_uri;
# Mitigate httpoxy (CVE-2016-5385 and friends).
proxy_set_header Proxy "";
{{- end }}

{{- define "listen" }}
    listen {{ .Port }}{{ if .TLS }} ssl{{ end }}{{ if .Default }} default_server{{ end }};
    {{- if .IPv6 }}
    listen [::]:{{ .Port }}{{ if .TLS }} ssl{{ end }}{{ if .Default }} default_server{{ end }};
    {{- end }}
{{- end }}

{{- define "acme_location" }}
    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        auth_request off;
        allow all;
        root /usr/share/nginx/html;
        try_files $uri =404;
        break;
    }
{{- end }}

{{- define "access_log" }}
    {{- if . }}
    access_log /var/log/nginx/access.log vhost;
    {{- end }}
{{- end }}

{{- define "error_page" }}
    {{- if . }}
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html/errors;
        internal;
    }
    {{- end }}
{{- end }}

{{- define "ssl_policy" }}
    {{- if eq . "Mozilla-Modern" }}
    ssl_protocols TLSv1.3;
    ssl_prefer_server_ciphers off;
    {{- else if eq . "Mozilla-Old" }}
    ssl_protocols TLSv1 TLSv1.1 TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-SHA256:ECDHE-RSA-AES128-SHA256:ECDHE-ECDSA-AES128-SHA:ECDHE-RSA-AES128-SHA:ECDHE-ECDSA-AES256-SHA384:ECDHE-RSA-AES256-SHA384:ECDHE-ECDSA-AES256-SHA:ECDHE-RSA-AES256-SHA:DHE-RSA-AES128-SHA256:DHE-RSA-AES256-SHA256:AES128-GCM-SHA256:AES256-GCM-SHA384:AES128-SHA256:AES256-SHA256:AES128-SHA:AES256-SHA:DES-CBC3-SHA:@SECLEVEL=0';
    ssl_prefer_server_ciphers on;
    {{- else }}
    {{- /* Mozilla-Intermediate, the default. */}}
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305';
    ssl_prefer_server_ciphers off;
    {{- end }}
{{- end }}

{{- define "location" }}
    {{- $loc := .Loc }}
    {{- if $loc.Override }}
    include {{ globEscape $loc.Override }};
    {{- else }}
    location {{ $loc.Path }} {
        {{- if $loc.Internal }}
        # Only allow traffic from internal clients.
        include /etc/nginx/network_internal.conf;
        {{- end }}
        {{- if eq $loc.Proto "uwsgi" }}
        include uwsgi_params;
        # Mitigate httpoxy: never pass a client's Proxy header on as HTTP_PROXY.
        uwsgi_param HTTP_PROXY "";
        uwsgi_pass uwsgi://{{ $loc.Upstream }};
        {{- else if eq $loc.Proto "fastcgi" }}
        include fastcgi_params;
        # Mitigate httpoxy: never pass a client's Proxy header on as HTTP_PROXY.
        fastcgi_param HTTP_PROXY "";
        root {{ $loc.Root }};
        fastcgi_pass {{ $loc.Upstream }};
        {{- if $loc.Keepalive }}
        fastcgi_keep_conn on;
        {{- end }}
        {{- else if or (eq $loc.Proto "grpc") (eq $loc.Proto "grpcs") }}
        grpc_pass {{ $loc.Proto }}://{{ $loc.Upstream }};
        grpc_set_header X-Real-IP $remote_addr;
        {{- else }}
        proxy_pass {{ $loc.Proto }}://{{ $loc.Upstream }}{{ $loc.Dest }};
        set $upstream_keepalive {{ $loc.Keepalive }};
        {{- end }}
        {{- if $loc.AuthFile }}
        auth_basic "{{ $loc.AuthRealm }}";
        auth_basic_user_file {{ $loc.AuthFile }};
        {{- end }}
        {{- if $loc.Include }}
        include {{ globEscape $loc.Include }};
        {{- end }}
    }
    {{- end }}
{{- end }}

{{- define "vhost_body" }}
    {{- $vh := .VHost }}
    {{- if $vh.ServerTokens }}
    server_tokens {{ $vh.ServerTokens }};
    {{- end }}
    {{- template "access_log" .Root.EnableAccessLog }}
    {{- if $vh.Include }}
    include {{ globEscape $vh.Include }};
    {{- end }}
    {{- range $vh.Locations }}
    {{- template "location" (dict "Loc" .) }}
    {{- end }}
    {{- if $vh.DefaultRoot }}
    location / {
        return {{ $vh.DefaultRoot }};
    }
    {{- end }}
{{- end }}

{{- /* ---------------------------------------------------------------- */}}
{{- /* Upstreams                                                         */}}
{{- range .Upstreams }}

upstream {{ .Name }} {
    {{- if .LoadBalance }}
    {{ .LoadBalance }}
    {{- end }}
    {{- range .Servers }}
    server {{ . }};
    {{- else }}
    # No reachable container; nginx needs at least one server.
    server 127.0.0.1 down;
    {{- end }}
    {{- if ne .Keepalive "disabled" }}
    keepalive {{ .Keepalive }};
    {{- end }}
}
{{- end }}

{{- /* ---------------------------------------------------------------- */}}
{{- /* Fallback servers for unknown hosts                                */}}
{{- if not .DefaultHTTPSet }}

server {
    server_name _;
    {{- template "listen" (dict "Port" .HTTPPort "TLS" false "Default" true "IPv6" .EnableIPv6) }}
    {{- template "access_log" .EnableAccessLog }}
    {{- if .ACMEAcceptUnknownHost }}
    {{- template "acme_location" }}
    {{- end }}
    {{- template "error_page" .ErrorPage }}
    location / {
        return 503;
    }
}
{{- end }}
{{- if not .DefaultTLSSet }}

server {
    server_name _;
    {{- template "listen" (dict "Port" .HTTPSPort "TLS" true "Default" true "IPv6" .EnableIPv6) }}
    {{- if .EnableHTTP2 }}
    http2 on;
    {{- end }}
    {{- template "access_log" .EnableAccessLog }}
    {{- if .DefaultCert }}
    {{- template "ssl_policy" .SSLPolicy }}
    ssl_certificate /etc/nginx/certs/default.crt;
    ssl_certificate_key /etc/nginx/certs/default.key;
    {{- template "error_page" .ErrorPage }}
    location / {
        return 503;
    }
    {{- else }}
    ssl_reject_handshake on;
    {{- end }}
}
{{- end }}

{{- /* ---------------------------------------------------------------- */}}
{{- /* Virtual hosts                                                     */}}
{{- $root := . }}
{{- range .VHosts }}
{{- $vh := . }}

# {{ $vh.Host }}
{{- if $vh.ServeHTTP }}
server {
    server_name {{ $vh.Host }};
    {{- template "listen" (dict "Port" $root.HTTPPort "TLS" false "Default" $vh.Default "IPv6" $root.EnableIPv6) }}
    {{- if $vh.ACMEChallenge }}
    {{- template "acme_location" }}
    {{- end }}
    {{- if $vh.Redirect }}
    {{- template "access_log" $root.EnableAccessLog }}
    location / {
        {{- if ne $vh.NonGetRedirect "301" }}
        if ($request_method ~ (OPTIONS|POST|PUT|PATCH|DELETE)) {
            return {{ $vh.NonGetRedirect }} https://$host{{ if ne $vh.ExternalHTTPSPort "443" }}:{{ $vh.ExternalHTTPSPort }}{{ end }}$request_uri;
        }
        {{- end }}
        return 301 https://$host{{ if ne $vh.ExternalHTTPSPort "443" }}:{{ $vh.ExternalHTTPSPort }}{{ end }}$request_uri;
    }
    {{- else }}
    {{- template "vhost_body" (dict "VHost" $vh "Root" $root) }}
    {{- end }}
}
{{- else if $vh.ACMEChallenge }}
# HTTP is disabled for this host; only ACME challenges are answered on port {{ $root.HTTPPort }}.
server {
    server_name {{ $vh.Host }};
    {{- template "listen" (dict "Port" $root.HTTPPort "TLS" false "Default" false "IPv6" $root.EnableIPv6) }}
    {{- template "acme_location" }}
    location / {
        return 503;
    }
}
{{- end }}
{{- if $vh.ServeHTTPS }}

server {
    server_name {{ $vh.Host }};
    {{- template "listen" (dict "Port" $root.HTTPSPort "TLS" true "Default" $vh.Default "IPv6" $root.EnableIPv6) }}
    {{- if $vh.HTTP2 }}
    http2 on;
    {{- end }}
    {{- if $vh.Cert }}
    {{- template "ssl_policy" $vh.SSLPolicy }}
    ssl_certificate /etc/nginx/certs/{{ $vh.Cert }}.crt;
    ssl_certificate_key /etc/nginx/certs/{{ $vh.Cert }}.key;
    {{- if $vh.DHParam }}
    ssl_dhparam {{ $vh.DHParam }};
    {{- end }}
    {{- if $vh.HSTS }}
    set $sts_header "";
    if ($https) {
        set $sts_header "{{ $vh.HSTS }}";
    }
    add_header Strict-Transport-Security $sts_header always;
    {{- end }}
    {{- if $vh.ACMEChallenge }}
    {{- template "acme_location" }}
    {{- end }}
    {{- template "vhost_body" (dict "VHost" $vh "Root" $root) }}
    {{- else }}
    # No usable certificate for this host.
    ssl_reject_handshake on;
    {{- end }}
}
{{- end }}
{{- end }}
